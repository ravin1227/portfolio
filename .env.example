# GitHub API Token (optional - for real GitHub data)
# Get your token from: https://github.com/settings/tokens
# Required scopes: read:user
# If not provided, mock data will be displayed
GITHUB_TOKEN=example

# Resend API Key - Get this from https://resend.com/api-keys
# Required for contact form email functionality
RESEND_API_KEY=example

# Your email address where you want to receive contact form submissions
RECIPIENT_EMAIL=your@email.com